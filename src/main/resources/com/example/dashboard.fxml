<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="com.example.DashboardController"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@style/style.css">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="220" spacing="4" styleClass="sidebar">

            <padding>
                <Insets top="24" right="16" bottom="24" left="16"/>
            </padding>

            <Label text="Kurtera" styleClass="sidebar-brand"/>

            <Region prefHeight="20"/>

            <!-- MENU DASHBOARD -->
            <Button fx:id="dashboardButton"
                    text="Dashboard"
                    maxWidth="Infinity"
                    styleClass="sidebar-item-active"/>

            <!-- MENU PROFIL USAHA -->
            <Button fx:id="profilButton" text="Profil Usaha"
                    maxWidth="Infinity"
                    styleClass="sidebar-item"
                    onAction="#handleProfilUsaha"/>

            <!-- MENU TRANSAKSI -->
            <Button fx:id="transaksiButton" text="Transaksi"
                    maxWidth="Infinity"
                    styleClass="sidebar-item"
                    onAction="#handleTransaksi"/>

            <!-- MENU SKOR KELAYAKAN -->
            <Button text="Skor Kelayakan"
                    maxWidth="Infinity"
                    styleClass="sidebar-item"/>

            <!-- MENU LAPORAN KUR -->
            <Button fx:id="laporanButton"
                    text="Laporan KUR"
                    maxWidth="Infinity"
                    styleClass="sidebar-item"
                    onAction="#handleLaporanKUR"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- LOGOUT -->
            <Button fx:id="logoutButton"
                    text="Logout"
                    maxWidth="Infinity"
                    styleClass="sidebar-item-logout"/>

        </VBox>
    </left>

    <!-- AREA KONTEN -->
    <center>
        <StackPane fx:id="contentArea"
                   styleClass="content-area"/>
    </center>

</BorderPane>
